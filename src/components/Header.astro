---
// En-tête commun : menu déroulant (bureau) et panneau (mobile).
// L'état actif du lien est calculé au build à partir de l'URL de la page courante.
const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/';
const actif = (href) => (href.replace(/\/+$/, '') || '/') === chemin ? 'lien-actif' : undefined;
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="/" aria-label="SAFIA, accueil"><svg viewBox="0 0 322.15 127.53" fill="currentColor" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SAFIA"><path d="M322.15,92v1.16s-8.71-.43-8.71-.43l-5.05-13.8-27.02.05-4.99,13.89-8.51-.21,22.36-61.6,9.54.16,22.37,60.77ZM306.15,72.26l-11.24-31.01-11.2,31.15,22.44-.15Z"/><path d="M181.58,79.03l-27.2-.1-4.98,13.87-8.55-.15,22.39-61.61,9.5.06,22.26,61.57-8.64.14-4.78-13.78ZM179.13,72.26l-11.23-31.05-11.2,31.19,22.43-.14Z"/><path d="M122.33,91.37c-7.1,3.1-14.94,2.64-21.46-.23-6.06-2.67-10-7.61-10.26-14.87l8.61-.19c1,8.01,7.92,11.59,15.62,10.32,4.82-.8,8.86-3.93,9.56-8.2.79-4.85-1.53-9.55-6.64-11.12l-14.41-4.44c-6.4-1.97-11.21-6.11-12.09-11.69-1.05-6.7.57-13.03,6.21-17,7.63-5.37,18.3-5.59,26.48-1.07,4.93,2.72,7.59,7.31,8.32,12.91l-8.92.02c-1.78-6.86-7.73-9.44-14.11-8.94-5.39.42-9.31,3.67-9.92,8.54s2.5,8.98,7.71,10.58l13.81,4.27c3.46,1.07,7.92,3.73,9.75,6.91,5.12,8.89,1.36,20-8.26,24.21Z"/><path d="M37.35,100.43c-6.69,15.7-20.32,27.04-37.35,27.09,28.83-9.18,34.76-34.57,32.89-63.71-.81-28.72,14.57-60.98,44.47-63.82-25.5,9.58-35.63,36.93-34.86,63.8.36,12.54-.05,24.68-5.15,36.63Z"/><polygon points="234.72 58.15 234.96 64.77 213.05 64.76 213.07 92.82 204.88 92.7 204.87 30.67 239.97 30.67 239.96 37.25 213.07 37.31 213.05 58.17 234.72 58.15"/><polygon points="257.95 92.61 249.78 92.7 249.78 30.81 257.94 30.77 257.95 92.61"/></svg></a>
    <nav aria-label="Navigation principale">
      <ul class="menu">
        <li>
          <button aria-haspopup="true">Particuliers <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></button>
          <ul class="sous">
            <li><a href="/particuliers/" class={actif("/particuliers/")}><strong>Particuliers</strong><span>Voir, comprendre et décider pour ton patrimoine</span></a></li>
            <li><a href="/adn-investisseur/" class={actif("/adn-investisseur/")}><strong>ADN Investisseur</strong><span>Investir selon ce qui compte pour toi</span></a></li>
            <li><a href="/assistant-ia/" class={actif("/assistant-ia/")}><strong>Assistant IA</strong><span>Une IA qui montre son raisonnement</span></a></li>
            <li><a href="/cockpit/" class={actif("/cockpit/")}><strong>Cockpit stratégique</strong><span>Tes recommandations et ton audit patrimonial</span></a></li>
          </ul>
        </li>
        <li>
          <button aria-haspopup="true">Professionnels <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></button>
          <ul class="sous">
            <li><a href="/conseillers/" class={actif("/conseillers/")}><strong>Conseillers</strong><span>CGP, cabinets CIF, family offices</span></a></li>
            <li><a href="/institutions/" class={actif("/institutions/")}><strong>Institutions</strong><span>Banques et marque blanche</span></a></li>
          </ul>
        </li>
        <li><a href="/tarifs/" class={actif("/tarifs/")}>Tarifs</a></li>
        <li>
          <button aria-haspopup="true">Ressources <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></button>
          <ul class="sous">
            <li><a href="/outils/" class={actif("/outils/")}><strong>Outils</strong><span>Simulateurs gratuits, calculés dans ton navigateur</span></a></li>
            <li><a href="/comparatif/" class={actif("/comparatif/")}><strong>Comparatif</strong><span>Banque privée, gestion pilotée, agrégateur</span></a></li>
            <li><a href="/blog/" class={actif("/blog/")}><strong>Le blog</strong><span>Comprendre son argent, un sujet à la fois</span></a></li>
          </ul>
        </li>
        <li>
          <button aria-haspopup="true">À propos <svg class="chevron" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></button>
          <ul class="sous">
            <li><a href="/fondateur/" class={actif("/fondateur/")}><strong>Le fondateur</strong><span>Pourquoi SAFIA existe</span></a></li>
            <li><a href="/methode/" class={actif("/methode/")}><strong>Notre méthode</strong><span>Comment on construit nos analyses</span></a></li>
            <li><a href="/securite/" class={actif("/securite/")}><strong>Sécurité et conformité</strong><span>Où vont tes données</span></a></li>
          </ul>
        </li>
      </ul>
    </nav>
    <a class="btn btn-primaire btn-nav" href="/telecharger/" data-app>Télécharger l'app</a>
    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="panneau">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<!-- Le panneau mobile vit hors du <header> à dessein : la barre porte un
     backdrop-filter, et un élément filtré devient le bloc conteneur de ses
     descendants en position fixed. À l'intérieur, « inset:68px 0 0 0 » se
     calculait dans les 68 px de la barre — le panneau s'ouvrait sans hauteur,
     donc invisible. -->
<div class="panneau" id="panneau">
    <h3>Particuliers</h3>
    <a href="/particuliers/" class={actif("/particuliers/")}>Particuliers</a><a href="/adn-investisseur/" class={actif("/adn-investisseur/")}>ADN Investisseur</a><a href="/assistant-ia/" class={actif("/assistant-ia/")}>Assistant IA</a><a href="/cockpit/" class={actif("/cockpit/")}>Cockpit stratégique</a>
    <h3>Professionnels</h3>
    <a href="/conseillers/" class={actif("/conseillers/")}>Conseillers</a><a href="/institutions/" class={actif("/institutions/")}>Institutions</a>
    <h3>Ressources</h3>
    <a href="/outils/" class={actif("/outils/")}>Outils</a><a href="/comparatif/" class={actif("/comparatif/")}>Comparatif</a><a href="/blog/" class={actif("/blog/")}>Le blog</a>
    <h3>SAFIA</h3>
    <a href="/tarifs/" class={actif("/tarifs/")}>Tarifs</a><a href="/fondateur/" class={actif("/fondateur/")}>Le fondateur</a><a href="/methode/" class={actif("/methode/")}>Notre méthode</a><a href="/securite/" class={actif("/securite/")}>Sécurité et conformité</a>
  <a class="btn btn-primaire" href="/telecharger/" data-app>Télécharger l'app</a>
</div>
