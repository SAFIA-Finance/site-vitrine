---
// Gabarit unique du site : <head>, en-tête, pied de page et données structurées.
// Chaque page lui passe son référencement et, si elle en a, sa FAQ et son fil d'Ariane ;
// les JSON-LD correspondants sont alors écrits au build, pas au chargement.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import RetourHaut from '../components/RetourHaut.astro';
import ModaleTelechargement from '../components/ModaleTelechargement.astro';
// Transitions de page : la navigation se fait sans recharger, avec un fondu
// court. Conséquence à connaître — le corps du document est REMPLACÉ à chaque
// navigation, donc tout écouteur posé sur un élément disparaît avec lui.
// site.js se rebranche sur « astro:page-load » ; les scripts de page portent
// « data-astro-rerun », qui les rejoue. Voir les commentaires de site.js.
import { ClientRouter } from 'astro:transitions';
import { SITE_URL, INDEXABLE, SOCIETE, GA_ID, RELAIS_URL, APPLICATION, RESEAUX, RESEAUX_FONDATEUR } from '../config.js';
import pages from '../data/pages.json';
// Le catalogue des simulateurs, pour que chaque page sous /outils/ décrive
// l'outil qu'elle héberge sans avoir à se nommer elle-même.
import { OUTILS_PUBLIES } from '../calculs/outils.js';
import { depouiller } from '../blog.js';
import '../styles/global.css';

const {
  chemin,
  faq = [],
  fil = null,
  noindex = false,
  // Article de blog : produit un bloc BlogPosting en plus du reste.
  article = null,
  // Page de liste : le sommaire du blog et les onze pages de thème passent ici
  // leurs articles, dans l'ordre où la page les affiche. Produit une ItemList.
  // Une suite de liens ne dit pas à un moteur qu'il lit une liste, ni dans
  // quel ordre elle se lit ; ItemList le dit.
  liste = null,
  // Visuel de partage. Une page peut en fournir un ; sinon la carte de marque
  // est produite par outils/generer-images.mjs.
  image = '/og/defaut.png',
} = Astro.props;

// Le titre et la description des pages fixes viennent de src/data/pages.json,
// seule source de vérité de leur référencement.
//
// Les pages du blog font exception : elles sont produites à partir des articles,
// dont l'en-tête porte déjà le titre et la description. Les inscrire en double
// dans pages.json créerait deux vérités pour un même texte. Elles les passent
// donc en props — mais aucune page, fixe ou non, ne peut partir sans les deux.
const fiche = pages.find((p) => p.route === chemin);
const titre = Astro.props.titre ?? fiche?.titre;
const description = Astro.props.description ?? fiche?.description;
if (!titre || !description) {
  throw new Error(
    `Référencement absent pour ${chemin} : ajoute la page à src/data/pages.json, ou passe-lui « titre » et « description ».`,
  );
}

const canonique = new URL(chemin, SITE_URL).href;
const robots = !INDEXABLE || noindex ? 'noindex, nofollow' : 'index, follow';

// Carte de partage.
//
// Seuls les SIMULATEURS ont une carte à leur nom, et les articles du blog la
// leur, passée en prop. Toutes les autres pages retombent sur la carte de
// marque : leur carte affichait auparavant leur libellé de navigation, donc
// « Accueil », « Tarifs » ou « Blog » en très gros, ce qui n'annonce rien.
// Une page de présentation se partage pour la marque ; une page qu'on partage
// pour son sujet doit dire son sujet.
//
// La carte est DÉDUITE ici plutôt que passée par chaque page : la fiche de
// pages.json est déjà trouvée plus haut et son slug suffit. Une page qui
// fournit explicitement « image » garde la priorité.
//
// Les cartes des simulateurs sont produites par `npm run images`, celles des
// articles à la construction par outils/generer-og-articles.mjs.
const carteDeLaPage = fiche?.slug && chemin.startsWith('/outils/') ? `/og/${fiche.slug}.png` : null;
const visuel = Astro.props.image ?? carteDeLaPage ?? image;
const imageAbsolue = visuel ? new URL(visuel, SITE_URL).href : null;

// Fiche d'identité de l'éditeur, identique sur toutes les pages.
const organisation = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // Le site lui-même, et la recherche qu'il expose. Le gabarit du blog lit
      // « ?q= » depuis l'adresse : cette action décrit donc un comportement
      // réel, et non une intention.
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#site`,
      url: `${SITE_URL}/`,
      name: 'SAFIA',
      inLanguage: 'fr-FR',
      publisher: { '@id': `${SITE_URL}/#organisation` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_URL}/blog/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': ['Organization', 'FinancialService'],
      '@id': `${SITE_URL}/#organisation`,
      name: SOCIETE.nom,
      legalName: SOCIETE.raisonSociale,
      url: `${SITE_URL}/`,
      description:
        "Application de gestion de patrimoine assistée par intelligence artificielle explicable. SAFIA SAS est conseiller en investissements financiers enregistré à l'ORIAS.",
      // Google demande « logo » sur une Organization pour pouvoir l'afficher
      // dans son panneau de connaissance : sans lui, la fiche reste valide mais
      // sort sans image. C'est `icon-512.png`, produit par `npm run images` à
      // partir du MÊME tracé que l'icône iOS et celles du manifeste. Une seule
      // image de marque déclinée en tailles, jamais trois dessins qui dérivent.
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/icon-512.png`,
        width: 512,
        height: 512,
      },
      email: SOCIETE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SOCIETE.rue,
        postalCode: SOCIETE.codePostal,
        addressLocality: SOCIETE.ville,
        addressCountry: SOCIETE.pays,
      },
      foundingDate: '2025-12',
      founder: { '@id': `${SITE_URL}/fondateur/#personne` },
      areaServed: { '@type': 'Country', name: 'France' },
      identifier: [
        { '@type': 'PropertyValue', name: 'SIREN', value: SOCIETE.siren },
        { '@type': 'PropertyValue', name: 'ORIAS', value: SOCIETE.orias },
      ],
      memberOf: { '@type': 'Organization', name: 'CNCGP' },
      // « sameAs » : les comptes que Google doit rattacher à cette entreprise.
      // La liste est celle du pied de page, pour qu'aucun compte affiché ne
      // manque ici, et inversement.
      sameAs: RESEAUX.map((r) => r.url),
    },
    {
      '@type': 'MobileApplication',
      '@id': `${SITE_URL}/#application`,
      name: 'SAFIA',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'iOS, Android',
      publisher: { '@id': `${SITE_URL}/#organisation` },
      offers: [
        { '@type': 'Offer', name: 'Starter', price: '0', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Smart mensuel', price: '29.99', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Smart annuel', price: '299', priceCurrency: 'EUR' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/fondateur/#personne`,
      name: 'Maxime Bouché',
      jobTitle: 'Fondateur et président',
      worksFor: { '@id': `${SITE_URL}/#organisation` },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'IÉSEG School of Management' },
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Certification AMF, connaissances générales',
          recognizedBy: { '@type': 'Organization', name: 'Autorité des marchés financiers' },
        },
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Certification AMF, finance durable',
          recognizedBy: { '@type': 'Organization', name: 'Autorité des marchés financiers' },
        },
      ],
      sameAs: RESEAUX_FONDATEUR.map((r) => r.url),
    },
  ],
};

const jsonFaq = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      // Les données structurées attendent du TEXTE, pas du balisage. Sans ce
      // dépouillement, « **au sein du même assureur** » partirait vers Google
      // avec ses astérisques, dans la réponse même affichée en résultat de
      // recherche. Les questions n'en portent aucun aujourd'hui, mais ne
      // protéger que les réponses laisserait le piège ouvert de leur côté.
      mainEntity: faq.map((x) => ({
        '@type': 'Question',
        name: depouiller(x.q),
        acceptedAnswer: { '@type': 'Answer', text: depouiller(x.r) },
      })),
    }
  : null;

// Article de blog : l'auteur et l'éditeur renvoient aux fiches déjà décrites
// plus haut, plutôt que d'être redéclarés.
const jsonArticle = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: article.titre,
      description,
      inLanguage: 'fr-FR',
      datePublished: article.date,
      dateModified: article.maj ?? article.date,
      articleSection: article.categorie,
      mainEntityOfPage: canonique,
      author: { '@id': `${SITE_URL}/fondateur/#personne` },
      publisher: { '@id': `${SITE_URL}/#organisation` },
      // La carte de partage propre à l'article, produite à la construction par
      // outils/generer-og-articles.mjs et déjà passée en prop par
      // blog/[slug].astro. Sans « image », l'article reste valide pour Google
      // mais perd les affichages enrichis qui en dépendent.
      image: imageAbsolue,
      url: canonique,
      // Compté à la conversion, en même temps que la durée de lecture. Utile
      // aux moteurs génératifs, qui privilégient les contenus substantiels :
      // les 123 articles dépassent tous 1 200 mots, autant le dire.
      wordCount: article.mots,
      // Rien n'est derrière un péage sur ce site. Le déclarer évite qu'un
      // article soit pris pour l'extrait gratuit d'un contenu payant, ce que
      // la présence d'une offre payante dans le même graphe pourrait suggérer.
      isAccessibleForFree: true,
    }
  : null;

// Simulateur : chaque page sous /outils/ décrit l'outil qu'elle héberge.
//
// L'outil est DÉDUIT de `chemin` et résolu dans le catalogue, exactement comme
// la carte de partage plus haut. Deux conséquences qui valent mieux qu'une
// prop : aucune des neuf pages n'a à se déclarer elle-même, et un outil
// dépublié cesse d'être décrit en même temps qu'il cesse d'être lié.
//
// « WebApplication » plutôt que « SoftwareApplication » : c'en est une
// sous-classe, et elle dit la chose exacte, un outil qui s'exécute dans le
// navigateur. Rien à installer, rien à envoyer : le calcul ne quitte pas la
// machine du visiteur, ce que `browserRequirements` et l'offre à zéro euro
// disent ensemble.
const outilDeLaPage = OUTILS_PUBLIES.find((o) => o.route === chemin) ?? null;

const jsonOutil = outilDeLaPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: outilDeLaPage.nom,
      url: canonique,
      description: outilDeLaPage.resume,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Tout navigateur web',
      browserRequirements: 'JavaScript',
      inLanguage: 'fr-FR',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      publisher: { '@id': `${SITE_URL}/#organisation` },
    }
  : null;

// Page de liste : le sommaire du blog et les onze pages de thème.
//
// L'ordre déclaré est celui de la page, qui trie du plus récent au plus ancien.
// `depouiller` parce qu'un titre peut porter du gras : les données structurées
// attendent du texte, pas du balisage.
const jsonListe = liste?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: liste.length,
      itemListElement: liste.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(e.url, SITE_URL).href,
        name: depouiller(e.nom),
      })),
    }
  : null;

// Le fil d'Ariane visible est une suite de libellés. Google, lui, attend une
// adresse — « item » — sur chaque échelon : sans elle, il ignore le bloc et
// n'affiche aucun chemin sous le résultat. C'était le cas sur les 164 pages.
//
// Trois libellés intermédiaires sont des rubriques de menu, sans page à elles :
// « Professionnels », « Ressources » et « À propos ». On ne peut pas leur
// inventer une adresse, et un échelon sans « item » rendrait le bloc inutile.
// Ils sont donc retirés du JSON-LD, qui décrit ainsi un chemin entièrement
// cliquable, pendant que le fil AFFICHÉ reste inchangé.
const ADRESSES_DU_FIL = {
  Accueil: '/',
  Particuliers: '/particuliers/',
  Outils: '/outils/',
  'Le blog': '/blog/',
};

const jsonFil = (() => {
  if (!fil) return null;
  const echelons = fil
    // Le dernier échelon est la page courante : son adresse est déjà connue.
    .map((nom, i) => ({ nom, url: i === fil.length - 1 ? chemin : ADRESSES_DU_FIL[nom] }))
    .filter((e) => e.url);
  // Un fil d'un seul échelon ne décrit aucun chemin.
  if (echelons.length < 2) return null;
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: echelons.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: e.nom,
      item: new URL(e.url, SITE_URL).href,
    })),
  };
})();
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="safia-ga" content={GA_ID} />
    <meta name="safia-relais" content={RELAIS_URL} />
    <meta name="safia-app-ios" content={APPLICATION.ios} />
    <meta name="safia-app-android" content={APPLICATION.android} />
    <link rel="canonical" href={canonique} />
    {/* Le latin seul est préchargé : c'est le jeu dont chaque page a besoin.
        Les deux jeux de la famille vivaient en base64 dans la feuille de
        style, soit 54 Ko de son poids, téléchargés ensemble sur toutes les
        pages et réinvalidés à la moindre correction de style. Sortis en
        fichiers, ils sont mis en cache à part et demandés séparément.
        Le second jeu, dit latin étendu, n'est pas inutile en français : la
        ligature « œ » (U+0153) est déclarée dans les DEUX plages, et c'est la
        seconde qui l'emporte puisqu'elle est déclarée en dernier. Une page qui
        contient un « œ » télécharge donc les deux fichiers. Mesuré sur le
        build : onze pages sur 164 sont dans ce cas, les 153 autres ne prennent
        que le latin. */}
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* La couleur de la barre du navigateur sur mobile, reprise du fond
        sombre de l'en-tête pour que la barre et la page ne se démarquent pas. */}
    <meta name="theme-color" content="#130C36" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Le manifeste déclare le nom, les couleurs et les icônes du site.
        Il est en « display: browser » à dessein : le site ne doit PAS
        s'installer comme une application, SAFIA en ayant une vraie sur les
        deux magasins. En « standalone », Chrome proposerait d'installer la
        vitrine, et un visiteur se retrouverait avec un raccourci marketing
        en croyant tenir l'application.
        Arbitrage de Maxime du 20 septembre 2026. */}
    <link rel="manifest" href="/site.webmanifest" />

    {/* Les 123 articles se déclaraient « website », donc comme des pages
        d'accueil, aux réseaux sociaux comme aux agrégateurs. */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:modified_time" content={article.maj ?? article.date} />}
    {article && <meta property="article:section" content={article.categorie} />}
    {article && <meta property="article:author" content="Maxime Bouché" />}
    <meta property="og:site_name" content="SAFIA" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {imageAbsolue && <meta property="og:image" content={imageAbsolue} />}
    {imageAbsolue && <meta property="og:image:width" content="1200" />}
    {imageAbsolue && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content={imageAbsolue ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    {imageAbsolue && <meta name="twitter:image" content={imageAbsolue} />}

    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {jsonFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonFaq)} />}
    {jsonFil && <script type="application/ld+json" set:html={JSON.stringify(jsonFil)} />}
    {jsonArticle && <script type="application/ld+json" set:html={JSON.stringify(jsonArticle)} />}
    {jsonOutil && <script type="application/ld+json" set:html={JSON.stringify(jsonOutil)} />}
    {jsonListe && <script type="application/ld+json" set:html={JSON.stringify(jsonListe)} />}

    <ClientRouter />
  </head>

  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Header />

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <p class="annonce" id="annonce" role="status" aria-live="polite"></p>
    <p id="note-maquette" role="status" hidden></p>

    <RetourHaut />
    <BandeauCookies />
    <ModaleTelechargement />

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
