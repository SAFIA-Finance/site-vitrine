---
// Sommaire du blog. Les cartes sont produites à partir des articles réels :
// la maquette affichait six emplacements et sept liens sans destination.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { slugCategorie, dateFr, dateIso, parDate } from '../blog.js';

const fil = ['Accueil', 'Ressources', 'Le blog'];

const articles = (await getCollection('blog', ({ data }) => !data.brouillon)).sort(parDate);
const [une, ...suite] = articles;

// L'ordre des thèmes suit le plan éditorial, pas l'alphabet.
const categories = [...new Set(articles.map((a) => a.data.categorie))];
const compte = (c) => articles.filter((a) => a.data.categorie === c).length;
---

<Base
  chemin={"/blog/"}
  fil={fil}
  liste={articles.map((a) => ({ nom: a.data.titre, url: `/blog/${a.id}/` }))}
>
<section class="hero hero-page hero-part">
<div class="wrap hero-page-in hero-court">
  <p class="etiq-page">Ressources</p>
  <p class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span aria-hidden="true">/</span> Ressources <span aria-hidden="true">/</span> Le blog</p>
  <h1>Comprendre son argent, un sujet à la fois.</h1>
  <p class="chapo">Des articles par un conseiller en gestion de patrimoine. Sans jargon, sans promesse de rendement, et avec les sources. Apprends ce que tu veux, simplement.</p>
  <form class="recherche" role="search" id="recherche-blog">
    <label class="sr" for="q-blog">Rechercher un article</label>
    <input id="q-blog" type="search" placeholder="Livret A, PEA, succession, ETF…" autocomplete="off">
    <button class="btn btn-primaire" type="submit">Rechercher</button>
  </form>
  <!-- Le retour doit être ICI, sous le champ : la liste filtrée commence près
       de 1 000 px plus bas, hors de l'écran. Sans ce compteur, la recherche
       paraissait sans effet. -->
  <p class="recherche-retour" id="recherche-retour" role="status" hidden></p>
</div>
</section>

<section class="bloc blog-bloc">
<div class="wrap">
  <nav class="filtres" aria-label="Thématiques">
    <a class="f-btn actif" href="/blog/" aria-current="page">Tout <span class="f-nb">{articles.length}</span></a>
    {categories.map((c) => (
      <a class="f-btn" href={`/blog/categorie/${slugCategorie(c)}/`}>{c} <span class="f-nb">{compte(c)}</span></a>
    ))}
  </nav>

  <article class="une" data-titre={`${une.data.titre} ${une.data.description} ${une.data.categorie}`}>
    <div class="une-texte">
      <p class="meta">
        <span class="theme">{une.data.categorie}</span>
        <span aria-hidden="true"> · </span>
        <time datetime={dateIso(une.data.date)}>{dateFr(une.data.date)}</time>
        <span aria-hidden="true"> · </span>{une.data.lecture} min de lecture
      </p>
      <h2><a class="art-titre" href={`/blog/${une.id}/`}>{une.data.titre}</a></h2>
      <p class="chapo-art">{une.data.description}</p>
      <p class="auteur"><img class="pastille-auteur" src="/images/blog-98175c76.jpg" width="160" height="160" alt=""> Maxime Bouché · Conseiller en investissements financiers</p>
      <a class="lien" href={`/blog/${une.id}/`}>Lire l'article</a>
    </div>
  </article>

  <h2 class="titre titre-liste">Tous les articles</h2>
  <p class="resultat-recherche" id="resultat-recherche" role="status" hidden></p>
  <div class="articles" id="liste-articles">
    {suite.map((a) => (
      <article class="art" data-titre={`${a.data.titre} ${a.data.description} ${a.data.categorie}`}>
        <p class="meta">
          <span class="theme">{a.data.categorie}</span>
          <span aria-hidden="true"> · </span>
          <time datetime={dateIso(a.data.date)}>{dateFr(a.data.date)}</time>
          <span aria-hidden="true"> · </span>{a.data.lecture} min
        </p>
        <h3><a class="art-titre" href={`/blog/${a.id}/`}>{a.data.titre}</a></h3>
        <p>{a.data.description}</p>
      </article>
    ))}
  </div>
</div>
</section>

<!-- ===== Passerelles vers les pages du site ===== -->
<section class="bloc passerelles-bloc">
<div class="wrap">
  <h2 class="titre">Aller plus loin</h2>
  <div class="passerelles">
    <a class="pass" href="/adn-investisseur/"><h3>ADN Investisseur</h3><p>Pour les articles sur l'ESG, l'ISR et l'investissement selon ses valeurs.</p></a>
    <a class="pass" href="/assistant-ia/"><h3>Assistant IA</h3><p>Pour les articles sur l'IA appliquée à l'argent.</p></a>
    <a class="pass" href="/cockpit/"><h3>Cockpit stratégique</h3><p>Pour les articles sur l'analyse de portefeuille et l'audit patrimonial.</p></a>
    <a class="pass" href="/comparatif/"><h3>Comparatif</h3><p>Pour les articles qui comparent des solutions entre elles.</p></a>
  </div>
</div>
</section>

<section class="final">
<div class="wrap final-simple">
  <h2>Reçois les prochains articles.</h2>
  <p>Nos analyses patrimoine et investissement, une fois par mois, directement par email.</p>
  <form class="champ champ-centre" id="nl-blog" novalidate>
    <p class="pot" aria-hidden="true"><label for="site-blog">Laisser vide</label><input id="site-blog" name="site" type="text" tabindex="-1" autocomplete="off"></p>
    <label class="sr" for="email-blog">Adresse email</label>
    <input id="email-blog" type="email" placeholder="ton@email.fr" autocomplete="email" required>
    <button class="btn btn-primaire" type="submit">Je m'inscris</button>
  </form>
  <p class="confirm" id="confirm-blog" role="status" hidden></p>
  <small>Tu peux te désinscrire à tout moment.</small>
</div>
</section>
</Base>

<script>
  import '../scripts/pages/blog.js';
</script>
