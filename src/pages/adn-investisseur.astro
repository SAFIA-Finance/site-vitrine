        </div>

        <div class="adn-jauge" id="jauge">
          <div class="tete"><div><b>Déblocage</b><div class="niv" id="niveau">Niveau de confiance : Émergent</div></div><span id="pourcent">1 %</span></div>
          <div class="barre"><i id="barre" style="width:4%"></i></div>
        </div>

        <div class="adn-actions" id="choix">
          <button type="button" class="non" data-avis="non" aria-label="Ça ne m'intéresse pas"><svg viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></button>
          <button type="button" class="passe" data-avis="passe" aria-label="Passer"><svg viewBox="0 0 20 20" fill="none"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button type="button" class="oui" data-avis="oui" aria-label="Ça compte pour moi"><svg viewBox="0 0 20 20" fill="none"><path d="M10 17s-7-4.2-7-9.3A3.7 3.7 0 0110 5.8 3.7 3.7 0 0117 7.7c0 5.1-7 9.3-7 9.3z" fill="currentColor"/></svg></button>
