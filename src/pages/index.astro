---
import Base from '../layouts/Base.astro';
import { PREUVES, noteConsolidee } from '../config.js';

// Une seule note affichée, pondérée par le nombre d'avis de chaque magasin.
const note = noteConsolidee();

const faq = [
  {
    "q": "SAFIA, c'est quoi ?",
    "r": "Une application mobile qui réunit ton patrimoine, identifie tes préférences d'investissement et t'aide à comprendre tes options grâce à une IA explicable. Elle est conçue en France par une société enregistrée comme conseiller en investissements financiers."
  },
  {
    "q": "SAFIA gère-t-elle mon argent ?",
    "r": "Non. SAFIA ne détient pas tes fonds et ne passe aucun ordre. Tes comptes restent où ils sont : SAFIA les lit pour t'aider à comprendre et à décider."
  },
  {
    "q": "Combien ça coûte ?",
    "r": "Starter est gratuit. Smart coûte 29,99 € par mois, ou 299 € par an avec en plus l'accompagnement d'un conseiller."
  },
  {
    "q": "Mes données sont-elles en sécurité ?",
    "r": "Elles sont hébergées dans l'Union européenne, la connexion bancaire se fait en lecture seule via Powens et les accès sensibles sont chiffrés. Tout le détail est sur la page Sécurité et conformité."
  }
];
---

<Base
  chemin={"/"}
  faq={faq}
>
<!-- ===================== LE FIL =====================
     Un trait unique qui traverse toute la page et se dessine à mesure qu'on
     descend. Il reprend le geste du ∫ du logo, sans en tracer le glyphe : le
     logo est une forme PLEINE et fermée, l'animer au trait en dessinerait le
     contour avant de le remplir — un effet bâtard.

     preserveAspectRatio="none" laisse le tracé s'étirer sur toute la hauteur de
     la page, quelle qu'elle soit : aucune position n'est écrite en dur.
     Le dévoilement se fait par rognage du conteneur, pas par pointillé : voir
     le commentaire de « .fil path » dans global.css.

     Décoratif : aria-hidden, et hors du flux. Sans JavaScript, il est
     entièrement tracé — l'état par défaut est l'état final. -->
<div class="fil" aria-hidden="true">
  <svg viewBox="0 0 100 1000" preserveAspectRatio="none" focusable="false">
    <defs>
      <linearGradient id="fil-degrade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3B2CF2" />
        <stop offset="45%" stop-color="#8A3CF0" />
        <stop offset="100%" stop-color="#E48BEF" />
      </linearGradient>
    </defs>
    <path
      pathLength="1"
      d="M50 0 C 18 110, 82 230, 50 350 S 14 580, 50 700 S 88 860, 50 1000"
    />
  </svg>
</div>

<!-- ===================== HERO ===================== -->
<section class="hero">
<div class="wrap hero-in">
  <div>
    <h1>Le conseiller privé que tu n'as jamais eu.</h1>
    <p class="chapo">SAFIA est l'intelligence qui réunit tout ton patrimoine, apprend ce qui compte pour toi, t'explique tout clairement et t'accompagne toute ta vie : de ton premier euro à la transmission.</p>
    <div class="actions">
      <a class="btn btn-primaire" href="/telecharger/" data-app>Télécharger l'app, c'est gratuit</a>
      <a class="btn btn-fantome" href="/adn-investisseur/">Découvrir mon ADN investisseur</a>
    </div>
    <!-- Les chiffres restent SOUS les boutons, à dessein. Les remonter a été
         essayé et mesuré le 16 septembre 2026 : cela pousse les boutons d'une
         soixantaine de pixels vers le bas, donc dans la zone que le bandeau
         cookies recouvre tant que le visiteur n'a pas répondu. L'échange est
         perdant — ce sont les boutons qui font télécharger. -->
    <ul class="preuves" aria-label="Chiffres d'usage">
      <li><b>{PREUVES.telechargements}</b><span>téléchargements</span></li>
      <li><b>{PREUVES.patrimoine}</b><span>de patrimoine agrégé</span></li>
      {note && (
        <li><b>{note.valeur} <span class="preuves-etoile" aria-hidden="true">★</span></b><span>sur {note.avis} avis {note.magasins.join(' et ')}</span></li>
      )}
    </ul>
    {PREUVES.beta && <p class="beta">{PREUVES.beta}</p>}
    <ul class="garanties">
      <li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke="#E48BEF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Agrégation illimitée gratuite</li>
      <li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke="#E48BEF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Données hébergées dans l'UE. Respect de la RGPD.</li>
      <li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke="#E48BEF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>CIF enregistré à l'ORIAS pour t'aider.</li>
    </ul>
  </div>

  <!-- Démo : écran Mon IA, conforme à l'application -->
  <div class="tel-app" aria-label="Exemple de conversation avec l'assistant SAFIA">
    <div class="ecran-app">
      <div class="statut" aria-hidden="true"><span>9:41</span><span class="encoche"></span><span>▮▮▮ <i></i></span></div>
      <div class="app-entete"><span class="retour" aria-hidden="true">‹</span><p class="app-h">Mon IA</p><span class="rond" aria-hidden="true">+</span><span class="pts" aria-hidden="true">⋮</span></div>
      <div class="seg" aria-hidden="true"><span class="actif">Conversation</span><span>Personnaliser mon IA</span><span class="ruban">Smart</span></div>
      <div class="conv-app">
        <span class="heure seq" data-seq="0" aria-hidden="true">15:30</span>
        <div class="b-user seq" data-seq="0">Dans quoi investir ?</div>
        <div class="b-ia frappe seq" data-seq="1" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="seq" data-seq="2">
          <svg class="etincelle" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9L12 2.5z" fill="#fff"/></svg>
          <!-- Réponse volontairement courte. La version précédente tenait en deux
               paragraphes, deux sous-titres et quatre puces : l'écran du téléphone
               n'ayant aucune hauteur maximale, ce contenu le faisait grandir jusqu'à
               dominer le hero, et personne ne lit un pavé dans une démonstration de
               huit secondes. -->
          <div class="b-ia">
            <p>Livret A plein, épargne de précaution en place. En revanche, pas encore de PEA.</p>
            <p class="ss-titre">Ce que je te propose</p>
            <ul>
              <li>Analyser tes placements : frais, risque, valeurs</li>
              <li>Puis construire une allocation qui te ressemble</li>
            </ul>
            <!-- Les sources ont leur propre temps dans la séquence : elles
                 arrivent APRÈS la réponse. C'est le différenciateur de SAFIA,
                 il est mis en scène au lieu d'être noyé en bas de bulle. -->
            <p class="src-bulle seq" data-seq="3">Sources : tes comptes connectés au 13/09/2026 · Méthodologie SAFIA · Réglementation française.</p>
          </div>
        </div>
      </div>
      <div class="champ-msg" aria-hidden="true"><span class="plus">+</span><span>Tape ton message ici</span><i class="envoi"></i></div>
      <div class="app-bas" aria-hidden="true">
        <span><b></b>Accueil</span><span><b></b>Patrimoine</span><span class="actif"><b></b>Mon IA</span><span><b></b>ADN</span><span><b></b>Cockpit</span>
      </div>
      <p class="mention-app">Exemple illustratif. Information générale, pas un conseil en investissement personnalisé.</p>
    </div>
  </div>
</div>

<div class="bandeau" aria-label="Ils nous accompagnent">
  <div class="bandeau-piste">
    <ul class="marque-liste">
      <li>Scaleway</li><li>Mistral AI</li><li>Powens</li><li>IÉSEG Incubateur</li><li>Bpifrance</li><li>Région Île-de-France</li><li>CNCGP</li>
    </ul>
    <ul class="marque-liste" aria-hidden="true">
      <li>Scaleway</li><li>Mistral AI</li><li>Powens</li><li>IÉSEG Incubateur</li><li>Bpifrance</li><li>Région Île-de-France</li><li>CNCGP</li>
    </ul>
  </div>
</div>

<div class="wrap aiguillage">
  <h2>Tu es…</h2>
  <div class="voies">
    <a class="voie" href="/particuliers/"><strong>Un particulier</strong><span>Comprendre et faire grandir ton patrimoine</span></a>
    <a class="voie" href="/conseillers/"><strong>Conseiller en gestion de patrimoine</strong><span>Outiller son cabinet et servir plus de clients</span></a>
    <a class="voie" href="/institutions/"><strong>Une banque ou une institution</strong><span>Intégrer une IA patrimoniale à sa marque</span></a>
  </div>
</div>
</section>

<!-- ===================== L'ORIGINE =====================
     Le paragraphe le plus fort du site était sur /fondateur/, à trois clics de
     l'accueil : l'histoire familiale d'où vient SAFIA. Aucun concurrent ne peut
     la copier, et elle fonde le constat qui suit — d'où sa place ici, AVANT lui.

     Traitement purement typographique : pas de photographie. Une image de
     banque d'images sur ce registre détruirait la crédibilité plus vite que
     n'importe quel défaut technique, et le budget d'une vraie série n'est pas
     là. Une phrase, un nom, un filet.

     Attention à la redondance : l'accueil porte déjà un bloc fondateur plus bas,
     avec portrait et citation. Les deux ne disent pas la même chose — ici le
     POURQUOI (l'histoire), là-bas la conviction produit. Ne pas les rapprocher
     sans relire les deux textes. -->
<section class="bloc origine-bloc">
<div class="wrap">
  <figure class="origine-cit">
    <blockquote>
      <p>Dans ma famille, nous avons vécu plusieurs décès inattendus. Et avec eux, des patrimoines
      transmis à des moments où personne n'était préparé à les gérer.</p>
    </blockquote>
    <figcaption>
      <span class="origine-nom">Maxime Bouché</span>
      <span class="origine-role">Fondateur de SAFIA</span>
    </figcaption>
  </figure>
  <p class="origine-suite">SAFIA est née de là.</p>
</div>
</section>

<!-- ===================== CONSTAT ===================== -->
<section class="bloc">
<div class="wrap constat">
  <h2 class="titre">Suivre, investir et optimiser son argent ne devrait pas dépendre de la taille de son compte.</h2>
  <p>Le conseil en investissement et gestion de patrimoine reste réservé à une élite. Les autres se débrouillent seuls, entre des produits opaques, peu performants, des vidéos YouTube et des choix que personne ne leur explique. SAFIA part d'un principe simple : chacun doit pouvoir comprendre son argent, décider en connaissance de cause, faire grandir son patrimoine tout au long de sa vie.</p>
</div>
</section>

<!-- ===================== VOIR COMPRENDRE DÉCIDER ===================== -->
<section class="bloc" style="padding-top:0">
<div class="wrap">
  <h2 class="triade-titre"><span>Suivre,</span><span>Construire,</span><span>Transmettre</span></h2>
  <div class="triade">
    <article class="pilier">
      <div class="vignette" aria-hidden="true">
        <div class="v-label">Patrimoine net</div>
        <div class="v-montant">184 250 €</div>
        <div class="barre"><i style="width:34%;background:#8F86FF"></i><i style="width:26%;background:#E48BEF"></i><i style="width:22%;background:#3CD68F"></i><i style="width:18%;background:rgba(255,255,255,.55)"></i></div>
        <div class="legende">
          <span><b style="background:#8F86FF"></b>Immobilier</span>
          <span><b style="background:#E48BEF"></b>Assurance vie</span>
          <span><b style="background:#3CD68F"></b>PEA</span>
          <span><b style="background:rgba(255,255,255,.55)"></b>Livrets</span>
        </div>
        <span class="illu">Exemple illustratif</span>
      </div>
      <h3>Tout ton patrimoine au même endroit</h3>
      <p>Comptes, épargne, placements, crédits, immobilier : ton patrimoine net et sa répartition en un coup d'œil.</p>
      <a class="lien" href="/particuliers/">Voir ce que tu obtiens aujourd'hui</a>
    </article>
    <article class="pilier">
      <div class="vignette" aria-hidden="true">
        <div class="carte-fond"></div>
        <div class="carte-swipe"><span class="cat">Secteur</span><strong>Énergies renouvelables</strong></div>
        <div class="choix">
          <span><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></span>
          <span><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 15s-6-3.6-6-8a3.2 3.2 0 016-1.6A3.2 3.2 0 0115 7c0 4.4-6 8-6 8z" fill="#fff"/></svg></span>
        </div>
        <span class="progression">18 réponses sur 25 pour ton premier ADN</span>
      </div>
      <h3>Des choix alignés avec tes valeurs</h3>
      <p>Ton ADN investisseur capte ce qui compte pour toi : objectifs, famille, secteurs, convictions, critères environnementaux et sociaux.</p>
      <a class="lien" href="/adn-investisseur/">Découvrir l'ADN Investisseur</a>
    </article>
    <article class="pilier">
      <div class="vignette" aria-hidden="true">
        <div class="v-reponse">Ton portefeuille est concentré à 41 % sur la tech américaine. Si ce secteur baisse, une grande partie de ton épargne baisse avec lui.</div>
        <div class="puces"><span>Pourquoi ?</span><span>Risques</span><span>Sources</span></div>
        <span class="illu">Exemple illustratif</span>
      </div>
      <h3>Une IA qui montre son raisonnement</h3>
      <p>Chaque réponse explique le pourquoi, les risques et l'horizon, et cite ses sources. Pas de boîte noire.</p>
      <a class="lien" href="/assistant-ia/">Découvrir l'assistant IA</a>
    </article>
  </div>
</div>
</section>

<!-- ===================== ÉTAPES ===================== -->
<section class="bloc etapes-bloc">
<div class="wrap">
  <h2 class="titre">Trois étapes pour commencer</h2>
  <ol class="etapes">
    <li><h3>Fais ton profil</h3><p>Un questionnaire réglementaire (objectifs, horizon, tolérance au risque), puis quelques swipes pour révéler ton ADN investisseur.</p></li>
    <li><h3>Connecte tes comptes</h3><p>En lecture seule, via Powens. SAFIA ne voit jamais tes identifiants bancaires et ne peut effectuer aucune opération.</p></li>
    <li><h3>Comprends et décide</h3><p>Ton tableau de bord, tes points d'attention et une IA pour répondre à tes questions. La décision reste la tienne.</p></li>
  </ol>
</div>
</section>

<!-- ===================== LA VIE =====================
     Le mantra du site dit « de ton premier euro à la transmission » — c'est une
     DURÉE, et rien sur la page ne la montrait. Cette frise met en scène six
     moments où les questions changent, et rattache à chacun le simulateur qui y
     répond : les neuf outils cessent d'être un tiroir pour devenir un usage.

     Le bloc de clôture n'est pas décoratif. Sans lui, la section vendrait neuf
     calculettes ; il dit ce que SAFIA fait au-delà du calcul — réunir, analyser,
     PROPOSER UNE ALLOCATION, et passer la main à un conseiller quand l'enjeu le
     demande. Aucun rendement n'est cité nulle part : sur le site d'un CIF, une
     trajectoire chiffrée serait une suggestion de performance. -->
<section class="bloc vie-bloc">
<div class="wrap">
  <p class="vie-etiquette">De ton premier euro à la transmission</p>
  <h2 class="titre">Les questions changent. L'accompagnement, non.</h2>
  <p class="vie-chapo">
    Un patrimoine ne se décide pas une fois pour toutes. Il se construit sur quarante ans, à des
    moments où les questions ne sont jamais les mêmes. À chacun d'eux, SAFIA répond à partir de
    tes chiffres.
  </p>

  <ol class="vie-liste">
    <li>
      <span class="vie-moment">Ton premier salaire</span>
      <p class="vie-question">«&nbsp;Combien je peux mettre de côté sans me serrer&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">SAFIA lit tes comptes, calcule ta capacité d'épargne réelle et fixe un montant tenable.</p>
      <a class="lien" href="/outils/simulateur-epargne/">Simulateur d'épargne</a>
    </li>
    <li>
      <span class="vie-moment">Ton premier placement</span>
      <p class="vie-question">«&nbsp;Mon livret est plein. J'en fais quoi&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">Ce que le temps fait à ton épargne, et pourquoi commencer tôt compte plus que commencer gros.</p>
      <a class="lien" href="/outils/interets-composes/">Intérêts composés</a>
    </li>
    <li>
      <span class="vie-moment">Tes revenus augmentent</span>
      <p class="vie-question">«&nbsp;Je paie combien d'impôt, et sur quelle tranche&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">Le calcul étape par étape, y compris le plafonnement et la décote que ta feuille d'impôt ne détaille pas.</p>
      <a class="lien" href="/outils/impot-revenu/">Impôt sur le revenu</a>
    </li>
    <li>
      <span class="vie-moment">Tu prépares ta retraite</span>
      <p class="vie-question">«&nbsp;Le PER, ça vaut le coup pour moi&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">L'économie d'impôt à l'entrée, et ce que la sortie coûtera. Les deux, jamais l'une sans l'autre.</p>
      <a class="lien" href="/outils/per/">Simulateur PER</a>
    </li>
    <li>
      <span class="vie-moment">Ton patrimoine grandit</span>
      <p class="vie-question">«&nbsp;PEA ou compte-titres, pour la même somme&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">La même épargne dans les deux enveloppes, et ce qu'il te reste vraiment à la fin.</p>
      <a class="lien" href="/outils/pea-cto/">PEA ou compte-titres</a>
    </li>
    <li>
      <span class="vie-moment">Tu penses à transmettre</span>
      <p class="vie-question">«&nbsp;Qu'est-ce qui restera vraiment à mes enfants&nbsp;?&nbsp;»</p>
      <p class="vie-reponse">Abattements et droits à payer selon le lien de parenté — et pourquoi partager change tout.</p>
      <a class="lien" href="/outils/succession/">Succession et donation</a>
    </li>
  </ol>

  <aside class="vie-suite">
    <div>
      <h3>Et au-delà du calcul</h3>
      <p>
        Un simulateur répond à une question, avec les chiffres que tu lui donnes. SAFIA réunit tes
        comptes, tient compte de ton profil de risque et de ton ADN investisseur, puis
        <strong>te propose une allocation qui te ressemble</strong>, l'explique et cite ses sources.
        Quand l'enjeu le demande, un conseiller SAFIA prend le relais.
      </p>
    </div>
    <a class="btn btn-encre" href="/telecharger/" data-app>Télécharger l'app</a>
  </aside>
</div>
</section>

<!-- ===================== CONFIANCE ===================== -->
<section class="bloc confiance" id="confiance">
<div class="wrap">
  <h2 class="titre">Une app financière, ça se choisit avec soin.</h2>
  <div class="garde">
    <div>
      <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3l9 4v6c0 5.6-3.8 10.2-9 12-5.2-1.8-9-6.4-9-12V7l9-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 14l3 3 5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h3>Un acteur réglementé</h3>
      <p>SAFIA est conseiller en investissements financiers, enregistré à l'ORIAS et membre de la CNCGP (Chambre Nationale des Conseils en Gestion de Patrimoine)</p>
    </div>
    <div>
      <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="1.8"/><path d="M4 14h20M14 4c3 3.2 3 16.8 0 20M14 4c-3 3.2-3 16.8 0 20" stroke="currentColor" stroke-width="1.8"/></svg>
      <h3>Tes données restent privées et confidentielles.</h3>
      <p>Hébergement chez Scaleway, fournisseur cloud français, dans l'Union européenne.</p>
    </div>
    <div>
      <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="5" y="12" width="18" height="12" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M9 12V9a5 5 0 0110 0v3" stroke="currentColor" stroke-width="1.8"/></svg>
      <h3>Connexion bancaire en lecture seule</h3>
      <p>Via Powens, agrégateur agréé par l'ACPR. SAFIA ne voit jamais tes identifiants et ne peut effectuer aucune opération.</p>
    </div>
    <div>
      <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M3 23c.8-4 3.6-6 7-6s6.2 2 7 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M18 8h7M18 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <h3>Un humain quand il le faut</h3>
      <p>Face à une situation complexe, l'IA te le dit et te propose d'échanger avec un conseiller.</p>
    </div>
  </div>
  <div class="registre">
    <p><strong>SAFIA SAS</strong>, conseiller en investissements financiers, ORIAS n° 26008152</p>
    <a class="lien" href="https://www.orias.fr" target="_blank" rel="noopener">Vérifier sur orias.fr</a>
  </div>
  <p style="margin-top:24px"><a class="lien lien-seul" href="/securite/">Tout savoir sur la sécurité et la conformité</a></p>
</div>
</section>

<!-- ===================== OFFRES ===================== -->
<section class="bloc" id="offres">
<div class="wrap">
  <h2 class="titre">Gratuit pour commencer. Smart pour aller plus loin.</h2>
  <div class="bascule" role="group" aria-label="Période de facturation">
    <button type="button" data-periode="mensuel" aria-pressed="false">Mensuel</button>
    <button type="button" data-periode="annuel" aria-pressed="true">Annuel<span class="badge">2 mois offerts</span></button>
  </div>
  <div class="offres">
    <article class="offre">
      <h3>Starter</h3>
      <p class="pour">Pour découvrir et y voir clair</p>
      <div class="prix"><strong>0 €</strong><span>pour toujours</span></div>
      <ul class="inclus">
        <li><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Comptes synchronisés illimités</li>
