// Le site de production : le dossier « dist » servi tel quel par Cloudflare.
// Publié par GitHub Actions à chaque poussée sur « main » (voir
// .github/workflows/deploy.yml et docs/DEPLOIEMENT.md), jamais à la main.
//
// Les en-têtes et les redirections ne sont pas ici : Cloudflare les lit dans
// « dist/_headers » (public/_headers) et « dist/_redirects »
// (outils/generer-redirections.mjs).
{
  "name": "safia-site",
  "compatibility_date": "2026-09-01",
  // Le site ne répond que sur son domaine. Une adresse en « workers.dev »
  // serait un duplicata indexable de tout le site.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Une ROUTE, pas un « custom domain ». Cloudflare refuse d'attacher un
    // domaine qui porte déjà des enregistrements DNS (erreur 100117, constatée
    // le 10 octobre 2026), et les supprimer d'abord aurait coupé le site. Une
    // route, elle, se pose d'avance et ne touche pas au DNS : elle prend effet
    // dès que l'enregistrement du domaine passe en « Proxied » (nuage orange).
    //
    // CONSÉQUENCE. L'enregistrement DNS de « safia.finance » doit exister et
    // rester en nuage orange. Repassé en gris, le site n'est plus servi par
    // Cloudflare. « www » n'est pas ici : il a son renvoi, dans renvoi-www/.
    { "pattern": "safia.finance/*", "zone_name": "safia.finance" }
  ],
  "assets": {
    "directory": "../dist",
    // Comme GitHub Pages : une adresse inconnue rend la page 404 du site avec
    // le code 404, et /contact/index.html renvoie vers /contact/.
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
